# Local-only PostgreSQL defaults used by compose.yaml; never reuse in a shared environment.
# Copy this file to .env only when you need to override the defaults.
POSTGRES_DB=efikas
POSTGRES_TEST_DB=efikas_test
POSTGRES_USER=efikas
POSTGRES_PASSWORD=efikas_local_only
POSTGRES_PORT=5432

# Optional one-time first-manager bootstrap; keep disabled after provisioning.
BLUESTARS_BOOTSTRAP_MANAGER_ENABLED=false
BLUESTARS_BOOTSTRAP_MANAGER_EMAIL=
BLUESTARS_BOOTSTRAP_MANAGER_PASSWORD=
BLUESTARS_BOOTSTRAP_MANAGER_NAME=
BLUESTARS_BOOTSTRAP_MANAGER_SURNAME=
BLUESTARS_BOOTSTRAP_MANAGER_JMBG=
BLUESTARS_BOOTSTRAP_MANAGER_ADDRESS=
BLUESTARS_BOOTSTRAP_MANAGER_PHONE=
