# Local-only PostgreSQL defaults used by compose.yaml; never reuse in a shared environment.
# Copy this file to .env only when you need to override the defaults.
POSTGRES_DB=efikas
POSTGRES_TEST_DB=efikas_test
POSTGRES_USER=efikas
POSTGRES_PASSWORD=efikas_local_only
POSTGRES_PORT=5432

# Optional one-time first-manager bootstrap; keep disabled after provisioning.
EFIKAS_BOOTSTRAP_MANAGER_ENABLED=false
EFIKAS_BOOTSTRAP_MANAGER_EMAIL=
EFIKAS_BOOTSTRAP_MANAGER_PASSWORD=
EFIKAS_BOOTSTRAP_MANAGER_NAME=
EFIKAS_BOOTSTRAP_MANAGER_SURNAME=
EFIKAS_BOOTSTRAP_MANAGER_JMBG=
EFIKAS_BOOTSTRAP_MANAGER_ADDRESS=
EFIKAS_BOOTSTRAP_MANAGER_PHONE=
